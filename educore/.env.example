# Firebase Cloud Messaging
FCM_PROJECT_ID=educore-35d95
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=

# Android release notification webhook
# Must match the protected MOBILE_RELEASE_WEBHOOK_TOKEN configured in Codemagic.
MOBILE_RELEASE_WEBHOOK_TOKEN=

# Platform email transport
# Email is platform-level infrastructure. Tenant-facing messages are branded
# per school, but must be sent through an authenticated platform mail account.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=
